if(NOT DEFINED OUTPUT_DIR)
    set(OUTPUT_DIR "${CMAKE_CURRENT_BINARY_DIR}/opus-section-placement-test")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(cmake_dir "${CMAKE_CURRENT_LIST_DIR}/../../cmake")
include("${cmake_dir}/opus_sections.cmake")

function(expect_section input expected_destination expected_kind)
    ds5_opus_section_destination("${input}" destination kind)
    if(NOT destination STREQUAL expected_destination OR NOT kind STREQUAL expected_kind)
        message(FATAL_ERROR "${input}: got ${destination}/${kind}, expected ${expected_destination}/${expected_kind}")
    endif()
    ds5_opus_section_destination("${destination}" repeated_destination repeated_kind)
    if(NOT repeated_destination STREQUAL destination OR NOT repeated_kind STREQUAL kind)
        message(FATAL_ERROR "Section normalization is not idempotent for ${input}")
    endif()
endfunction()
expect_section(".text" ".time_critical.opus.text" code)
expect_section(".text.encode.constprop.0" ".time_critical.opus.text.encode.constprop.0" code)
expect_section(".rodata" ".time_critical.opus.rodata" tables)
expect_section(".rodata.mdct_twiddles" ".time_critical.opus.rodata.mdct_twiddles" tables)
expect_section(".rodata.str1.4" ".rodata.opus_strings.str1.4" strings)
expect_section(".rodata.encode.isra.0.str1.4" ".rodata.opus_strings.encode.isra.0.str1.4" strings)
expect_section(".rodata.encode.str4.4" ".rodata.opus_strings.encode.str4.4" strings)
expect_section(".rodata.stride_table" ".time_critical.opus.rodata.stride_table" tables)
# Archives relocated by DS5 Bridge 1.x builds used whole-unit section names.
expect_section(".time_critical.opus_text" ".time_critical.opus.text" code)
expect_section(".time_critical.opus_rodata" ".time_critical.opus.rodata" tables)
expect_section(".time_critical.opus_strings" ".rodata.opus_strings" strings)
expect_section(".time_critical.opus.rodata.encode.str1.4" ".rodata.opus_strings.encode.str1.4" strings)
expect_section(".data.table_pointers" ".data.table_pointers" state)
expect_section(".bss.scratch" ".bss.scratch" state)
expect_section(".ARM.exidx.text.encode" ".ARM.exidx.text.encode" unwind)
expect_section(".custom_future_codec_section" ".custom_future_codec_section" unknown)

set(code " .time_critical.opus.text.encode\n                0x20001000 0x20 build/lib/opus/libopus.a(encoder.c.obj)\n")
set(tables " .time_critical.opus.rodata.twiddles 0x20001020 0x100 build/lib/opus/libopus.a(mdct.c.obj)\n")
set(strings " .rodata.opus_strings.encode.str1.4\n                0x10001000 0x0 build/lib/opus/libopus.a(encoder.c.obj)\n")
set(valid "${code}${tables}${strings}")
function(check_map name contents expected_result)
    set(map "${OUTPUT_DIR}/${name}.map")
    file(WRITE "${map}" "${contents}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DMAP=${map}" -P "${cmake_dir}/verify_opus_sections.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expected_result STREQUAL "pass")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${name} unexpectedly failed: ${output}${error}")
        endif()
    elseif(result EQUAL 0)
        message(FATAL_ERROR "${name} unexpectedly passed")
    endif()
endfunction()
check_map(valid "${valid}" pass)
check_map(discarded "${valid} .text.unused 0x00000000 0x80 build/lib/opus/libopus.a(encoder.c.obj)\n" pass)
check_map(debug_offset "${valid} .debug_info 0x001b9698 0x360f build/lib/opus/libopus.a(encoder.c.obj)\n" pass)
check_map(state "${valid} .bss.codec 0x20002000 0x100 build/lib/opus/libopus.a(encoder.c.obj)\n" pass)
check_map(unwind "${valid} .ARM.exidx.text.encode 0x10002000 0x8 build/lib/opus/libopus.a(encoder.c.obj)\n" pass)
check_map(code_in_flash "${valid} .text.forgotten 0x10002000 0x20 build/lib/opus/libopus.a(encoder.c.obj)\n" fail)
check_map(tables_in_flash "${valid} .rodata.forgotten 0x10002000 0x100 build/lib/opus/libopus.a(mdct.c.obj)\n" fail)
check_map(strings_in_sram "${valid} .time_critical.opus_strings 0x20002000 0x10 build/lib/opus/libopus.a(encoder.c.obj)\n" fail)
check_map(suffixed_strings_in_sram "${valid} .time_critical.opus.rodata.encode.str1.4 0x20002000 0x10 build/lib/opus/libopus.a(encoder.c.obj)\n" fail)
check_map(table_crosses_sram_end "${valid} .time_critical.opus.rodata.oversized 0x20081ff0 0x20 build/lib/opus/libopus.a(mdct.c.obj)\n" fail)
check_map(state_in_flash "${valid} .data.codec 0x10002000 0x100 build/lib/opus/libopus.a(encoder.c.obj)\n" fail)
check_map(unknown "${valid} .custom_future_codec_section 0x20002000 0x20 build/lib/opus/libopus.a(encoder.c.obj)\n" fail)
check_map(no_code "${tables}${strings}" fail)
check_map(no_tables "${code}${strings}" fail)
check_map(no_strings "${code}${tables}" pass)
check_map(empty "" fail)
message(STATUS "Opus section normalization and map placement fixtures passed")
