# Run after the Opus archive is updated. This supports both clean archives and
# older archives whose unsuffixed sections were already relocated in place.
foreach(required_value ARCHIVE OBJDUMP OBJCOPY)
    if(NOT DEFINED ${required_value} OR "${${required_value}}" STREQUAL "")
        message(FATAL_ERROR "relocate_opus_sections: missing -D${required_value}")
    endif()
endforeach()
if(NOT EXISTS "${ARCHIVE}")
    message(FATAL_ERROR "relocate_opus_sections: archive not found: ${ARCHIVE}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/opus_sections.cmake")

execute_process(COMMAND "${OBJDUMP}" -h "${ARCHIVE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE headers ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "relocate_opus_sections: objdump failed (${result}): ${error}")
endif()
string(REGEX MATCHALL "(^|\n)[ \t]*[0-9]+[ \t]+[.][^ \t\r\n]+[ \t]+[0-9a-fA-F]+" rows "${headers}")
if(NOT rows)
    message(FATAL_ERROR "relocate_opus_sections: no archive section headers found")
endif()
set(sections "")
foreach(row IN LISTS rows)
    string(REGEX MATCH "[0-9]+[ \t]+([.][^ \t\r\n]+)[ \t]+[0-9a-fA-F]+$" match "${row}")
    list(APPEND sections "${CMAKE_MATCH_1}")
endforeach()
list(REMOVE_DUPLICATES sections)
set(response "")
set(code_sections 0)
set(table_sections 0)
set(renamed_sections 0)
foreach(section IN LISTS sections)
    ds5_opus_section_destination("${section}" destination kind)
    if(kind STREQUAL "code")
        math(EXPR code_sections "${code_sections} + 1")
    elseif(kind STREQUAL "tables")
        math(EXPR table_sections "${table_sections} + 1")
    endif()
    if(NOT destination STREQUAL section)
        if(NOT section MATCHES "^[.A-Za-z0-9_$]+$" OR NOT destination MATCHES "^[.A-Za-z0-9_$]+$")
            message(FATAL_ERROR "relocate_opus_sections: unexpected section spelling: ${section}")
        endif()
        string(APPEND response "--rename-section\n\"${section}=${destination}\"\n")
        math(EXPR renamed_sections "${renamed_sections} + 1")
    endif()
endforeach()
if(code_sections EQUAL 0 OR table_sections EQUAL 0)
    message(FATAL_ERROR "relocate_opus_sections: Opus code or numerical sections missing")
endif()
if(renamed_sections GREATER 0)
    # A response file avoids Windows command-line limits with per-function
    # section names. No shell interprets its contents.
    set(response_file "${ARCHIVE}.relocate.rsp")
    file(WRITE "${response_file}" "${response}")
    execute_process(COMMAND "${OBJCOPY}" "@${response_file}" "${ARCHIVE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "relocate_opus_sections: objcopy failed (${result}): ${output}${error}")
    endif()
endif()
message(STATUS "Opus relocation: ${code_sections} code sections, ${table_sections} numerical sections, ${renamed_sections} renamed")
